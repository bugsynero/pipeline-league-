# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# First administrator account (created automatically on first successful auth request)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Optional: use only when the API is hosted separately from the Next.js app.
# NEXT_PUBLIC_API_URL=https://your-api.example.com/api

# Cloudinary image storage for player photos, news and match artwork
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
